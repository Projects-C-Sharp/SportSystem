<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SportSistem</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;600;700;800&family=Barlow:wght@400;500;600&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SportSistem.styles.css" asp-append-version="true" />

    <style>
        :root {
            --sport-black: #080C10;
            --sport-dark: #0D1117;
            --sport-card: #131920;
            --sport-border: rgba(255,255,255,0.07);
            --sport-orange: #FF4500;
            --sport-white: #F0F2F5;
            --sport-muted: rgba(240,242,245,0.45);
            --font-display: 'Barlow Condensed', sans-serif;
            --font-body: 'Barlow', sans-serif;
        }

        body {
            background: var(--sport-black);
            color: var(--sport-white);
            font-family: var(--font-body);
        }

        /* NAVBAR */
        .ss-nav {
            background: rgba(8,12,16,0.95);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--sport-border);
        }

        .ss-brand {
            font-family: var(--font-display);
            font-weight: 800;
            letter-spacing: .04em;
            color: var(--sport-white) !important;
            text-transform: uppercase;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .ss-brand-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--sport-orange);
            box-shadow: 0 0 10px var(--sport-orange);
        }

        .nav-link {
            font-family: var(--font-display);
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: .08em;
            font-size: .85rem;
            color: var(--sport-muted) !important;
        }

        .nav-link:hover {
            color: var(--sport-white) !important;
        }

        /* MAIN */
        .ss-main {
            max-width: 1280px;
            margin: 0 auto;
            padding: 2rem 1.2rem 4rem;
            min-height: calc(100vh - 120px);
        }

        /* FOOTER */
        .ss-footer {
            border-top: 1px solid var(--sport-border);
            text-align: center;
            padding: 1rem;
            color: var(--sport-muted);
            font-family: var(--font-display);
            font-size: .75rem;
            text-transform: uppercase;
        }

        /* MOBILE IMPROVEMENTS */
        @@media (max-width: 768px) {
            .ss-main {
                padding: 1.2rem;
            }
        }
        /* =========================
BUTTON SYSTEM UPGRADE
========================= */

        .btn-sport {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;

            padding: 0.9rem 1.4rem;
            border-radius: 10px;

            font-family: 'Barlow Condensed', sans-serif;
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            font-size: 0.85rem;

            color: #0b0b0b;
            background: linear-gradient(135deg, #ff4500, #ff6a1a);
            border: 1px solid transparent;

            cursor: pointer;
            text-decoration: none;

            transition: all 0.25s ease;
            box-shadow:
                0 10px 25px rgba(255, 69, 0, 0.25),
                inset 0 0 0 rgba(255, 255, 255, 0);
            position: relative;
            overflow: hidden;
        }

        /* brillo animado */
        .btn-sport::after {
            content: "";
            position: absolute;
            top: -50%;
            left: -60%;
            width: 40%;
            height: 200%;
            background: rgba(255,255,255,0.25);
            transform: rotate(25deg);
            transition: all 0.6s ease;
        }

        .btn-sport:hover::after {
            left: 120%;
        }

        .btn-sport:hover {
            transform: translateY(-3px);
            box-shadow:
                0 18px 40px rgba(255, 69, 0, 0.35);
        }

        /* SECONDARY BUTTON */
        .btn-sport-outline {
            background: transparent;
            color: var(--sport-white);
            border: 1px solid rgba(255, 69, 0, 0.6);
            box-shadow: none;
        }

        .btn-sport-outline:hover {
            background: rgba(255, 69, 0, 0.12);
            border-color: var(--sport-orange);
            transform: translateY(-3px);
        }

        /* ICON SPACING READY (por si luego agregas íconos) */
        .btn-sport svg {
            width: 16px;
            height: 16px;
        }
        :root {
            --sport-orange: #ff4500;
            --sport-white: #ffffff;
            --sport-muted: #a9a9a9;
            --sport-border: #2a2a2a;
            --sport-card: #141414;
            --sport-bg: #0b0b0b;
        }

        .ss-hero {
            min-height: 60vh;
            display: flex;
            align-items: center;
            position: relative;
            overflow: hidden;
            padding: 4rem 1.5rem;
            background: var(--sport-bg);
        }

        .ss-hero-bg {
            position: absolute;
            inset: 0;
            background:
                radial-gradient(ellipse 60% 80% at 80% 50%, rgba(255,69,0,0.08) 0%, transparent 65%),
                radial-gradient(ellipse 40% 60% at 20% 30%, rgba(255,69,0,0.04) 0%, transparent 60%);
            pointer-events: none;
        }

        .ss-hero-line {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(90deg, transparent, var(--sport-orange), transparent);
        }

        .ss-hero-content {
            position: relative;
            z-index: 1;
            max-width: 720px;
            width: 100%;
        }

        .ss-eyebrow {
            font-family: 'Barlow Condensed', sans-serif;
            font-size: 0.78rem;
            font-weight: 700;
            letter-spacing: 0.2em;
            text-transform: uppercase;
            color: var(--sport-orange);
            margin-bottom: 1rem;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .ss-eyebrow::before {
            content: '';
            width: 28px;
            height: 2px;
            background: var(--sport-orange);
        }

        .ss-hero-title {
            font-family: 'Barlow Condensed', sans-serif;
            font-size: clamp(2.5rem, 7vw, 6rem);
            font-weight: 800;
            text-transform: uppercase;
            line-height: 0.95;
            color: var(--sport-white);
            margin-bottom: 1.5rem;
        }

        .ss-hero-title em {
            font-style: normal;
            color: var(--sport-orange);
        }

        .ss-hero-desc {
            font-size: 1rem;
            color: var(--sport-muted);
            line-height: 1.7;
            margin-bottom: 2rem;
            max-width: 520px;
        }

        .ss-hero-actions {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
        }

        /* GRID RESPONSIVE (CLAVE) */
        .ss-stat-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 1px;
            background: var(--sport-border);
            border: 1px solid var(--sport-border);
            border-radius: 8px;
            overflow: hidden;
            margin: 3rem 1.5rem;
        }

        .ss-stat-cell {
            background: var(--sport-card);
            padding: 1.5rem;
            text-align: center;
        }

        .ss-stat-number {
            font-family: 'Barlow Condensed', sans-serif;
            font-size: 2rem;
            font-weight: 800;
            color: var(--sport-white);
            line-height: 1;
            margin-bottom: 4px;
        }

        .ss-stat-label {
            font-family: 'Barlow Condensed', sans-serif;
            font-size: 0.75rem;
            font-weight: 600;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            color: var(--sport-muted);
        }

        /* 📱 RESPONSIVE BREAKPOINTS */
        @@media (max-width: 992px) {
            .ss-stat-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @@media (max-width: 576px) {
            .ss-hero {
                padding: 3rem 1rem;
                text-align: center;
            }

            .ss-hero-content {
                margin: 0 auto;
            }

            .ss-hero-actions {
                justify-content: center;
            }

            .ss-stat-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>

<header>
    <nav class="navbar navbar-expand-lg ss-nav navbar-dark">
        <div class="container-fluid">

            <a class="navbar-brand ss-brand" asp-area="" asp-controller="Home" asp-action="Index">
                <span class="ss-brand-dot"></span>
                SportSystem
            </a>

            <!-- BOTÓN MOBILE -->
            <button class="navbar-toggler" type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#mainNavbar"
                    aria-controls="mainNavbar"
                    aria-expanded="false"
                    aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- LINKS -->
            <div class="collapse navbar-collapse" id="mainNavbar">
                <ul class="navbar-nav ms-auto gap-lg-2">

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="User" asp-action="Index">Users</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Space" asp-action="Index">Spaces</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Reservation" asp-action="Index">Reservations</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Privacy">Privacy</a>
                    </li>

                </ul>
            </div>

        </div>
    </nav>
</header>

<div class="ss-main">
    <main role="main">
        @RenderBody()
    </main>
</div>

<footer class="ss-footer">
    <div>
        &copy; 2026 SportSystem - Privacy
    </div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)

</body>
</html>