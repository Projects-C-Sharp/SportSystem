@model SportSistem.Models.Entities.Reservation

@{
    ViewData["Title"] = "Reservation Details";
}

<style>
    body {
        background: radial-gradient(circle at top, #111827, #0b1220 60%, #050814);
        color: white;
    }

    /* HEADER */
    .ss-page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2rem;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .ss-page-title {
        font-family: 'Barlow Condensed', sans-serif;
        font-size: 2rem;
        font-weight: 800;
        text-transform: uppercase;
        margin: 0;
    }

    .ss-page-title span {
        color: #ff4500;
    }

    /* CARD */
    .ss-card {
        background: rgba(20, 20, 20, 0.9);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 16px;
        max-width: 560px;
        margin: 0 auto;
        transition: 0.25s ease;
    }

    .ss-card:hover {
        border-color: rgba(255, 69, 0, 0.25);
        box-shadow: 0 12px 30px rgba(0,0,0,0.4);
    }

    .ss-card-body {
        padding: 2rem;
    }

    /* HEADER INFO INSIDE CARD */
    .reservation-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
        gap: 10px;
    }

    .reservation-id {
        font-family: 'Barlow Condensed', sans-serif;
        font-size: 0.85rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: #a9a9a9;
    }

    /* DETAIL ROW */
    .ss-detail {
        display: flex;
        justify-content: space-between;
        padding: 12px 0;
        border-bottom: 1px solid rgba(255,255,255,0.06);
    }

    .ss-detail:last-of-type {
        border-bottom: none;
    }

    .ss-detail-label {
        font-family: 'Barlow Condensed', sans-serif;
        font-size: 0.75rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: #a9a9a9;
    }

    .ss-detail-value {
        color: white;
        font-weight: 600;
        text-align: right;
        max-width: 60%;
        word-break: break-word;
    }

    /* BADGES */
    .ss-badge {
        display: inline-flex;
        padding: 4px 10px;
        border-radius: 999px;
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
    }

    .ss-badge-scheduled {
        background: rgba(255,145,0,0.12);
        color: #ffb14a;
        border: 1px solid rgba(255,145,0,0.25);
    }

    .ss-badge-cancelled {
        background: rgba(255,60,60,0.12);
        color: #ff6b6b;
        border: 1px solid rgba(255,60,60,0.25);
    }

    .ss-badge-completed {
        background: rgba(0,255,120,0.12);
        color: #7CFFB2;
        border: 1px solid rgba(0,255,120,0.25);
    }

    /* BUTTON SYSTEM */
    .btn-sport {
        padding: 0.9rem 1.2rem;
        border-radius: 10px;

        font-family: 'Barlow Condensed', sans-serif;
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;

        display: inline-flex;
        align-items: center;
        justify-content: center;

        text-decoration: none;
        border: none;
        cursor: pointer;

        transition: 0.2s ease;

        background: linear-gradient(135deg, #ff4500, #ff6a1a);
        color: #0b0b0b;

        box-shadow: 0 10px 25px rgba(255,69,0,0.2);
    }

    .btn-sport:hover {
        transform: translateY(-2px);
        box-shadow: 0 15px 35px rgba(255,69,0,0.3);
    }

    .btn-sport-outline {
        background: transparent;
        color: white;
        border: 1px solid rgba(255,69,0,0.5);
        box-shadow: none;
    }

    .btn-sport-outline:hover {
        background: rgba(255,69,0,0.1);
    }

    /* RESPONSIVE */
    @@media (max-width: 576px) {
        .ss-detail {
            flex-direction: column;
            align-items: flex-start;
            gap: 4px;
        }

        .ss-detail-value {
            text-align: left;
            max-width: 100%;
        }

        .reservation-header {
            flex-direction: column;
            align-items: flex-start;
        }
    }
</style>

<div class="ss-page-header">
    <h1 class="ss-page-title">Reservation <span>Details</span></h1>
    <a asp-action="Index" class="btn-sport btn-sport-outline">Back</a>
</div>

<div class="ss-card">
    <div class="ss-card-body">

        @{
            var badgeClass = Model.State switch
            {
                SportSistem.Models.Enums.StateReservation.Scheduled => "ss-badge-scheduled",
                SportSistem.Models.Enums.StateReservation.Cancelled => "ss-badge-cancelled",
                _ => "ss-badge-scheduled"
            };
        }

        <div class="reservation-header">
            <div class="reservation-id">
                Booking #@Model.Id
            </div>

            <span class="ss-badge @badgeClass">
                @Model.State
            </span>
        </div>

        <div class="ss-detail">
            <span class="ss-detail-label">User</span>
            <span class="ss-detail-value">@Model.User?.Name</span>
        </div>

        <div class="ss-detail">
            <span class="ss-detail-label">Space</span>
            <span class="ss-detail-value">@Model.Space?.Name</span>
        </div>

        <div class="ss-detail">
            <span class="ss-detail-label">Date</span>
            <span class="ss-detail-value">@Model.Date.ToShortDateString()</span>
        </div>

        <div class="ss-detail">
            <span class="ss-detail-label">Start Time</span>
            <span class="ss-detail-value">@Model.StartTime.ToShortTimeString()</span>
        </div>

        <div class="ss-detail">
            <span class="ss-detail-label">End Time</span>
            <span class="ss-detail-value">@Model.EndTime.ToShortTimeString()</span>
        </div>

        <div style="margin-top:1.5rem;">
            <a asp-action="Index" class="btn-sport btn-sport-outline">
                Back to Reservations
            </a>
        </div>

    </div>
</div>