@model SportSistem.Models.Entities.User

@{
    ViewData["Title"] = "User Details";
}

<style>
    body {
        background: radial-gradient(circle at top, #111827, #0b1220 60%, #050814);
        color: white;
    }

    /* HEADER */
    .ss-page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2rem;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .ss-page-title {
        font-family: 'Barlow Condensed', sans-serif;
        font-size: 2rem;
        font-weight: 800;
        text-transform: uppercase;
        margin: 0;
    }

    .ss-page-title span {
        color: #ff4500;
    }

    /* CARD */
    .ss-card {
        background: rgba(20, 20, 20, 0.9);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 16px;
        max-width: 560px;
        margin: 0 auto;
        transition: 0.25s ease;
    }

    .ss-card:hover {
        border-color: rgba(255, 69, 0, 0.25);
        box-shadow: 0 12px 30px rgba(0,0,0,0.4);
    }

    .ss-card-body {
        padding: 2rem;
    }

    /* HEADER USER */
    .user-header {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 1.5rem;
    }

    .ss-avatar {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background: linear-gradient(135deg, #ff4500, #ff7a18);
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        color: white;
        font-size: 1.3rem;
    }

    .user-title {
        display: flex;
        flex-direction: column;
        min-width: 0;
    }

    .user-name {
        font-family: 'Barlow Condensed', sans-serif;
        font-size: 1.4rem;
        font-weight: 800;
        text-transform: uppercase;
        margin: 0;
        color: white;

        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .user-email {
        font-size: 0.85rem;
        color: #a9a9a9;
        margin: 0;
    }

    /* DETAILS */
    .ss-detail {
        display: flex;
        justify-content: space-between;
        padding: 10px 0;
        border-bottom: 1px solid rgba(255,255,255,0.06);
        font-size: 0.9rem;
    }

    .ss-detail:last-of-type {
        border-bottom: none;
    }

    .ss-detail-label {
        font-family: 'Barlow Condensed', sans-serif;
        font-size: 0.75rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: #a9a9a9;
    }

    .ss-detail-value {
        color: white;
        font-weight: 500;
        text-align: right;
        word-break: break-word;
    }

    /* ACTIONS */
    .user-actions {
        display: flex;
        gap: 10px;
        margin-top: 1.5rem;
    }

    /* BUTTON SYSTEM (CONSISTENTE CON TODO) */
    .btn-sport {
        flex: 1;
        padding: 0.9rem 1rem;
        border-radius: 10px;

        font-family: 'Barlow Condensed', sans-serif;
        font-weight: 700;
        font-size: 0.8rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;

        display: inline-flex;
        align-items: center;
        justify-content: center;

        text-decoration: none;
        border: none;

        cursor: pointer;
        transition: all 0.2s ease;

        background: linear-gradient(135deg, #ff4500, #ff6a1a);
        color: #0b0b0b;

        box-shadow: 0 10px 25px rgba(255,69,0,0.2);
    }

    .btn-sport:hover {
        transform: translateY(-2px);
        box-shadow: 0 15px 35px rgba(255,69,0,0.3);
    }

    .btn-sport-outline {
        background: transparent;
        color: white;
        border: 1px solid rgba(255,69,0,0.5);
        box-shadow: none;
    }

    .btn-sport-outline:hover {
        background: rgba(255,69,0,0.1);
    }

    /* RESPONSIVE */
    @@media (max-width: 576px) {
        .ss-page-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .user-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .ss-detail {
            flex-direction: column;
            align-items: flex-start;
            gap: 4px;
        }

        .ss-detail-value {
            text-align: left;
        }
    }
</style>

<div class="ss-page-header">
    <h1 class="ss-page-title">User <span>Profile</span></h1>
    <a asp-action="Index" class="btn-sport btn-sport-outline">Back</a>
</div>

<div class="ss-card">
    <div class="ss-card-body">

        <div class="user-header">
            <div class="ss-avatar">
                @Model.Name.Substring(0, 1).ToUpper()
            </div>

            <div class="user-title">
                <p class="user-name">@Model.Name</p>
                <p class="user-email">@Model.Email</p>
            </div>
        </div>

        <div class="ss-detail">
            <span class="ss-detail-label">Identification</span>
            <span class="ss-detail-value">@Model.Identification</span>
        </div>

        <div class="ss-detail">
            <span class="ss-detail-label">Phone</span>
            <span class="ss-detail-value">@Model.Phone</span>
        </div>

        <div class="ss-detail">
            <span class="ss-detail-label">Email</span>
            <span class="ss-detail-value">@Model.Email</span>
        </div>

        <div class="user-actions">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-sport">Edit</a>
            <a asp-action="Index" class="btn-sport btn-sport-outline">Back</a>
        </div>

    </div>
</div>