@model SportSistem.Models.Entities.Space

@{
    ViewData["Title"] = "Space Details";
}

<style>
    body {
        background: radial-gradient(circle at top, #111827, #0b1220 60%, #050814);
        color: white;
    }

    /* HEADER */
    .ss-page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2rem;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .ss-page-title {
        font-family: 'Barlow Condensed', sans-serif;
        font-size: 2rem;
        font-weight: 800;
        text-transform: uppercase;
        margin: 0;
    }

    .ss-page-title span {
        color: #ff4500;
    }

    /* CARD */
    .ss-card {
        background: rgba(20, 20, 20, 0.9);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 16px;
        max-width: 560px;
        margin: 0 auto;
        transition: 0.25s ease;
    }

    .ss-card:hover {
        border-color: rgba(255, 69, 0, 0.25);
        box-shadow: 0 12px 30px rgba(0,0,0,0.4);
    }

    .ss-card-body {
        padding: 2rem;
    }

    /* TITLE */
    .space-title {
        font-family: 'Barlow Condensed', sans-serif;
        font-size: 2rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        margin: 0 0 1.5rem 0;
        color: white;
    }

    /* DETAIL ROW */
    .ss-detail {
        display: flex;
        justify-content: space-between;
        padding: 12px 0;
        border-bottom: 1px solid rgba(255,255,255,0.06);
    }

    .ss-detail:last-of-type {
        border-bottom: none;
    }

    .ss-detail-label {
        font-family: 'Barlow Condensed', sans-serif;
        font-size: 0.75rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: #a9a9a9;
    }

    .ss-detail-value {
        color: white;
        font-weight: 600;
    }

    /* BADGE */
    .ss-badge {
        display: inline-flex;
        padding: 4px 10px;
        border-radius: 999px;
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;

        background: rgba(255,145,0,0.12);
        color: #ffb14a;
        border: 1px solid rgba(255,145,0,0.25);
    }

    /* ACTIONS */
    .space-actions {
        display: flex;
        gap: 10px;
        margin-top: 1.5rem;
        flex-wrap: wrap;
    }

    /* BUTTON SYSTEM (CONSISTENTE GLOBAL) */
    .btn-sport {
        flex: 1;
        padding: 0.9rem 1.2rem;
        border-radius: 10px;

        font-family: 'Barlow Condensed', sans-serif;
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;

        display: inline-flex;
        align-items: center;
        justify-content: center;

        text-decoration: none;
        border: none;
        cursor: pointer;

        transition: 0.2s ease;

        background: linear-gradient(135deg, #ff4500, #ff6a1a);
        color: #0b0b0b;

        box-shadow: 0 10px 25px rgba(255,69,0,0.2);
    }

    .btn-sport:hover {
        transform: translateY(-2px);
        box-shadow: 0 15px 35px rgba(255,69,0,0.3);
    }

    .btn-sport-outline {
        background: transparent;
        color: white;
        border: 1px solid rgba(255,69,0,0.5);
        box-shadow: none;
    }

    .btn-sport-outline:hover {
        background: rgba(255,69,0,0.1);
    }

    /* RESPONSIVE */
    @@media (max-width: 576px) {
        .ss-page-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .ss-detail {
            flex-direction: column;
            gap: 4px;
        }
    }
</style>

<div class="ss-page-header">
    <h1 class="ss-page-title">Space <span>Details</span></h1>
    <a asp-action="Index" class="btn-sport btn-sport-outline">Back</a>
</div>

<div class="ss-card">
    <div class="ss-card-body">

        <h2 class="space-title">@Model.Name</h2>

        <div class="ss-detail">
            <span class="ss-detail-label">Type</span>
            <span class="ss-badge">@Model.SpaceType</span>
        </div>

        <div class="ss-detail">
            <span class="ss-detail-label">Capacity</span>
            <span class="ss-detail-value">@Model.Capacity persons</span>
        </div>

        <div class="space-actions">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-sport">
                Edit Space
            </a>

            <a asp-action="Index" class="btn-sport btn-sport-outline">
                Back
            </a>
        </div>

    </div>
</div>